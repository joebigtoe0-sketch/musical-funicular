# Paikallinen kehitys: kopioi .env.local
# Railway Dashboard → Variables

PORT=3000

ANTHROPIC_API_KEY=sk-ant-api03-...

SAIRAS_CALENDLY_URL=https://calendly.com/sairasmedia/alkukartoitus

# --- Sähköposti (tarjouspyynnöt & chatbot-liidit) ---

# Minne viestit lähetetään
CONTACT_EMAIL=info@sairasmedia.fi

# Lähettäjä (näkyy saapuneissa)
EMAIL_FROM="Sairas Media <info@sairasmedia.fi>"

# SMTP (esim. Gmail, Zoho, hosting-palvelun SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@sairasmedia.fi
SMTP_PASS=your-app-password-here
