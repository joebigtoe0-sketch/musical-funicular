# Paikallinen kehitys: kopioi .env.local
# Railway Dashboard → Variables

PORT=3000

# Julkinen sivuston osoite (pakollinen SEO:lle, sitemap, canonical, OG)
SITE_URL=https://sairasmedia.fi

# Google Search Console → HTML-tag verification → kopioi vain content-arvo
# GOOGLE_SITE_VERIFICATION=abc123xyz...

# Google Analytics 4 → Admin → Data Streams → Web → Measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

ANTHROPIC_API_KEY=sk-ant-api03-...

SAIRAS_CALENDLY_URL=https://calendly.com/sairasmedia/alkukartoitus

# --- Sähköposti (tarjouspyynnöt) ---

CONTACT_EMAIL=info@sairasmedia.fi

# SUOSITUS Railwaylle: Resend (one.com SMTP ei toimi pilvestä)
# 1. Luo tili: https://resend.com
# 2. API Keys → luo avain → RESEND_API_KEY
# 3. Domains → lisää sairasmedia.fi → DNS-tietueet one.comiin
# 4. Kun domain vahvistettu:
EMAIL_FROM=Sairas Media <noreply@sairasmedia.fi>
RESEND_API_KEY=re_xxxxxxxx

# Vain paikallinen dev / ei Railway:
# SMTP_HOST=send.one.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@sairasmedia.fi
# SMTP_PASS=your-mailbox-password
